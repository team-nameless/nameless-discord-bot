{
    "ruff.organizeImports": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "always",
        "source.organizeImports.ruff": "always"
    },
    "files.eol": "\n",
    "files.exclude": {
        "**/.venv/": true,
        "**/venv/": true,
        "**/__pycache__/": true,
        "**/.ruff_cache/": true,
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.venv/": true,
        "**/venv/": true,
        "**/__pycache__/": true,
        "**/.ruff_cache/": true,
    },
    "python.analysis.autoImportCompletions": false
}